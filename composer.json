{
    "name": "retrochaos/magento2-price-decimal",
    "description": "Magento 2 Price Decimal Precision",
    "keywords": [
        "magento2"
    ],
    "license": "Apache-2.0",
    "type": "magento2-module",
    "authors": [
        {
            "name": "LillikPro",
            "email": "support@lillik.pro",
            "role": "Developer"
        },
        {
            "name": "RetroChaos",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "magento/framework": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "RetroChaos\\PriceDecimal\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
